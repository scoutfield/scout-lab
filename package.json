{
  "name": "scout-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-server.mjs --port 5179",
    "check": "node scripts/check-extension.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:live": "node scripts/check-live-sources.mjs",
    "package": "node scripts/package-extension.mjs",
    "test:release": "npm run package && node scripts/smoke-release.mjs",
    "capture:store": "node scripts/capture-store-assets.mjs",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  }
}
